{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": [
      "bun-types"
    ],
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": [
    "packages/core/src",
    "packages/core/test",
    "packages/generator/src",
    "packages/generator/test",
    "packages/cli/src",
    "packages/cli/test",
    "packages/server/src",
    "packages/server/test",
    "packages/web/test",
    "packages/lsp/src",
    "packages/lsp/test",
    "packages/vscode/src"
  ]
}